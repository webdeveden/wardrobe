# Local (non-Docker) development. docker-compose overrides DATABASE_URL, PORT and FRONTEND_ORIGIN.
ENVIRONMENT=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wardrobe_catalog
# Comma-separated list of allowed CORS origins
FRONTEND_ORIGIN=http://localhost:5173
# Required when ENVIRONMENT=production
JWT_SECRET=change-me
OPENROUTER_API_KEY=
